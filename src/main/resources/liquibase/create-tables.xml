<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

    <changeSet id="1" author="chugun223">
        <createTable tableName="teams">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
        </createTable>
    </changeSet>

    <changeSet id="2" author="chugun223">
        <createTable tableName="users">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="username" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="password" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="team_id" type="bigint">
                <constraints foreignKeyName="fk_users_team" referencedTableName="teams" referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="3" author="chugun223">
        <createTable tableName="tasks">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="title" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="deadline" type="timestamp"/>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp"/>
            <column name="status" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="deadline_notified" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="assigned_user_id" type="bigint">
                <constraints foreignKeyName="fk_tasks_user" referencedTableName="users" referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="4" author="chugun223">
        <createTable tableName="files">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="filename" type="VARCHAR(255)"/>
            <column name="content_type" type="VARCHAR(255)"/>
            <column name="size" type="BIGINT"/>
            <column name="file_path" type="VARCHAR(500)" remarks="Path to file on disk">
                <constraints nullable="false"/>
            </column>
            <column name="uploaded_at" type="TIMESTAMP"/>
            <column name="task_id" type="BIGINT"/>
        </createTable>
        <addAutoIncrement columnName="id" tableName="files"/>
        <addForeignKeyConstraint baseTableName="files" baseColumnNames="task_id"
                                 referencedTableName="tasks" referencedColumnNames="id"
                                 constraintName="fk_files_task" onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
