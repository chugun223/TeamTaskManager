<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

    <changeSet id="1" author="chugun223">
        <createTable tableName="teams">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
        </createTable>
    </changeSet>

    <changeSet id="2" author="chugun223">
        <createTable tableName="users">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="username" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="password" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="team_id" type="bigint">
                <constraints foreignKeyName="fk_users_team" referencedTableName="teams" referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="3" author="chugun223">
        <createTable tableName="tasks">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="title" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="deadline" type="timestamp"/>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp"/>
            <column name="status" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="assigned_user_id" type="bigint">
                <constraints foreignKeyName="fk_tasks_user" referencedTableName="users" referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="4" author="chugun223">

        <insert tableName="teams">
            <column name="id" valueNumeric="1"/>
            <column name="name" value="Backend Team"/>
            <column name="description" value="Java team"/>
        </insert>

        <insert tableName="users">
            <column name="id" valueNumeric="1"/>
            <column name="username" value="leader"/>
            <column name="email" value="leader@mail.com"/>
            <column name="password" value="123"/>
            <column name="role" value="TEAMLEADER"/>
            <column name="team_id" valueNumeric="1"/>
        </insert>

        <insert tableName="users">
            <column name="id" valueNumeric="2"/>
            <column name="username" value="member"/>
            <column name="email" value="member@mail.com"/>
            <column name="password" value="123"/>
            <column name="role" value="MEMBER"/>
            <column name="team_id" valueNumeric="1"/>
        </insert>

        <insert tableName="tasks">
            <column name="id" valueNumeric="1"/>
            <column name="title" value="Сделать API"/>
            <column name="description" value="Написать контроллеры"/>
            <column name="deadline" valueDate="2026-04-10T12:00:00"/>
            <column name="created_at" valueDate="2026-04-06T12:00:00"/>
            <column name="status" value="NEW"/>
            <column name="assigned_user_id" valueNumeric="2"/>
        </insert>
    </changeSet>
</databaseChangeLog>
